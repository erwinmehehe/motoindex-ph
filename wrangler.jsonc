{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "motoindex-ph",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "motoindexph.com/*",
      "zone_name": "motoindexph.com"
    },
    {
      "pattern": "www.motoindexph.com/*",
      "zone_name": "motoindexph.com"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": [
      "/", "/finder", "/gas-price-philippines", "/tools/motorcycle-loan-calculator",
      "/guides/*",
      "/motorcycles", "/motorcycles/*",
      "/api/*",
      "/admin", "/admin/*",
      "/my", "/my/*",
      "/garage", "/garage/*",
      "/dealer-portal", "/dealer-portal/*",
      "/dealer-lead", "/dealer-lead/*",
      "/quote-status", "/quote-status/*",
      "/price-alerts", "/price-alerts/*",
      "/get-quote/*",
      "/dealers/join", "/dealers/join/*",
      "/used-motorcycles/listing/*",
      "/go/*", "/sellers"
    ],
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "node scripts/ensure-cloudflare-worker.mjs"
  }
}
