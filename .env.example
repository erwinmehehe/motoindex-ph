# Public site identity (required for production launch)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin protection (required for /admin and ingestion surfaces)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Database (required for Prisma-backed production features)
DATABASE_URL=

# Analytics (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Privacy default: search terms are NOT captured unless this is explicitly true.
NEXT_PUBLIC_ANALYTICS_CAPTURE_SEARCH_TERMS=false

# Affiliate links (server-only).
# Keys are MotoIndex catalog product IDs. Values may use direct Shopee links or approved Involve Asia deeplinks.
# Keep empty until your affiliate accounts/offers are approved and real tracking links have been generated.
AFFILIATE_LINKS_JSON={}

# Legacy v2.2.1 config remains supported during migration. AFFILIATE_LINKS_JSON overrides the same product ID.
SHOPEE_AFFILIATE_LINKS_JSON={}

# Involve Asia deeplink automation (server/CLI only; NEVER use NEXT_PUBLIC_ for these).
# Get a fresh Key + Secret from Involve Asia Profile > Tools > API.
INVOLVE_ASIA_API_KEY=
INVOLVE_ASIA_API_SECRET=
INVOLVE_ASIA_API_BASE_URL=https://api.involve.asia/api
# Optional. The generator defaults to /auth; if Involve Asia changes it, paste the exact current auth HTTP Request URL here.
INVOLVE_ASIA_AUTH_URL=
# Recommended: set the approved Shopee Philippines offer ID shown in /offers/all.
# If omitted, the generator tries to resolve an approved PH Shopee offer by name and refuses ambiguous matches.
INVOLVE_ASIA_SHOPEE_PH_OFFER_ID=
INVOLVE_ASIA_SHOPEE_PH_OFFER_NAME=Shopee
# Optional product-ID overrides when the catalog source page is not the marketplace destination you want to monetize.
# Example: {"helmet-product-id":"https://shopee.ph/..."}
AFFILIATE_DESTINATIONS_JSON={}
# Default true: products without a direct Shopee price source get a Shopee search deeplink for "Brand Model".
# Set false if you only want explicit/direct Shopee destinations.
INVOLVE_ASIA_SHOPEE_SEARCH_FALLBACK=true
