# MotoIndex PH production environment template
# Copy values into your hosting provider. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=https://motoindexph.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Admin protection. Recommended production mode: cloudflare after Access/Zero Trust + MFA is configured.
# Comma-separate approved identities in ADMIN_ACCESS_EMAILS.
ADMIN_ACCESS_MODE=basic
ADMIN_ACCESS_EMAILS=
# Required when ADMIN_ACCESS_MODE=cloudflare. Example: your-team.cloudflareaccess.com
CF_ACCESS_TEAM_DOMAIN=
# Cloudflare Access Application AUD tag.
CF_ACCESS_AUD=
ADMIN_USERNAME=replace-with-8-plus-character-admin-user
ADMIN_PASSWORD=replace-with-a-strong-20-plus-character-password

# Optional for the current public research/SEO launch.
# Required only when Prisma-backed ingestion/history features are activated.
DATABASE_URL=

# Google AdSense (optional; disabled by default).
# ads.txt is served at /ads.txt only when ADSENSE_PUBLISHER_ID is a real pub- + 16 digit ID.
# Keep NEXT_PUBLIC_ADSENSE_ENABLED=false until the AdSense account and required consent controls are ready.
ADSENSE_PUBLISHER_ID=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_ENABLED=false
# Separate disabled-until-approved AdSense privacy/CSP release gate; not mapped by prod workflow.
NEXT_PUBLIC_ADSENSE_RELEASE_GATES_APPROVED=false

# Optional analytics: fail-closed until account, consent and private-URL QA under issue #466.
# Production maps the build flag only if BOTH GitHub production Environment variables
# MOTOINDEX_ANALYTICS_SAFE_ENABLE and MOTOINDEX_ANALYTICS_RELEASE_GATES_APPROVED
# are explicitly true, after independently documented acceptance on issue #466.
NEXT_PUBLIC_ANALYTICS_SAFE_ENABLE=false
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Legacy setting, kept off. Free-text searches are never exported as analytics events.
NEXT_PUBLIC_ANALYTICS_CAPTURE_SEARCH_TERMS=false

# Optional commerce. Empty maps keep affiliate CTAs safely disabled.
AFFILIATE_LINKS_JSON={}
SHOPEE_AFFILIATE_LINKS_JSON={}

# Optional Involve Asia bulk-deeplink generation. Prefer running the generator before deployment;
# generated links are saved to data/affiliate-links.generated.json and no API secret is needed at visitor click time.
INVOLVE_ASIA_API_KEY=
INVOLVE_ASIA_API_SECRET=
INVOLVE_ASIA_API_BASE_URL=https://api.involve.asia/api
INVOLVE_ASIA_AUTH_URL=
INVOLVE_ASIA_SHOPEE_PH_OFFER_ID=
INVOLVE_ASIA_SHOPEE_PH_OFFER_NAME=Shopee
AFFILIATE_DESTINATIONS_JSON={}
INVOLVE_ASIA_SHOPEE_SEARCH_FALLBACK=true

# Search Console / Bing ownership tokens (optional).
# Paste only the content="..." value, not the whole meta tag.
# Server-only (no NEXT_PUBLIC_ prefix): rendered into <head>, never inlined into client JS.
# Omitted from the rendered <head> when unset. Read at BUILD time - redeploy after changing.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Dealer Portal (disabled by default).
# Requires DATABASE_URL, RESEND_API_KEY and the dealer-platform Prisma migration.
DEALER_PORTAL_ENABLED=false
# Sender must be verified by your email provider. Falls back to OWNER_AUTH_FROM_EMAIL / PRICE_ALERT_FROM_EMAIL.
DEALER_AUTH_FROM_EMAIL=
# Passwordless dealer session lifetime in days. Clamped to 1-90; defaults to 30.
DEALER_SESSION_DAYS=30

# Garage-verified owner reviews. Enable only after migration + moderation are ready.
OWNER_REVIEWS_ENABLED=false
