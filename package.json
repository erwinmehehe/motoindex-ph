{
  "name": "motoindex-ph",
  "version": "2.9.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/write-build-info.mjs",
    "build": "next build",
    "start": "next start",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy:built": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:legacy-links": "node scripts/check-legacy-recommendation-links.mjs",
    "audit:freshness": "node scripts/audit-freshness.mjs",
    "visual:qa": "node scripts/visual-qa.mjs && node scripts/visual-qa-editorial.mjs && node scripts/visual-qa-model-fallback.mjs",
    "validate:all": "npm run validate:post-audit && npm run validate:seo-hardening && npm run validate:market-hubs && npm run validate:priority-model-growth && npm run validate:budget-displacement && npm run validate:no-competitors && npm run validate:copy-tone && npm run validate:public-trust && node scripts/validate-authority-growth.mjs && node scripts/validate-premium-light.mjs && npm run check:links && npm run check:legacy-links && npm run audit:freshness && node scripts/validate-content.mjs && node scripts/validate-product-layer.mjs && npm run validate:media && npm run validate:media-backfill",
    "prisma:validate": "node scripts/prisma-validate.mjs",
    "verify": "npm run validate:all && npm run validate:lockfile && npm run prisma:validate && npm run validate:design && npm run lint && npm run typecheck && npm run build",
    "check:launch": "node scripts/check-launch.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "verify:launch": "npm run check:launch && npm run check:affiliate-build && npm run verify",
    "validate:launch-hardening": "node scripts/validate-launch-hardening.mjs",
    "validate:lockfile": "node scripts/validate-lockfile.mjs",
    "validate:copy-tone": "node scripts/validate-copy-tone.mjs",
    "validate:public-trust": "node scripts/validate-public-trust.mjs",
    "launch:status": "node scripts/launch-status.mjs",
    "refresh:security-lock": "npm install --package-lock-only --ignore-scripts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "node prisma/seed.mjs",
    "launch:prepare": "node scripts/prepare-launch.mjs",
    "check:affiliate-build": "node scripts/check-affiliate-build.mjs",
    "media:sync": "node scripts/sync-entity-media.mjs",
    "validate:media": "node scripts/validate-media.mjs",
    "validate:media-backfill": "node scripts/validate-media-backfill-safety.mjs",
    "affiliates:preview": "node scripts/generate-involve-affiliates.mjs --dry-run",
    "affiliates:generate": "node scripts/generate-involve-affiliates.mjs",
    "validate:no-competitors": "node scripts/validate-no-competitors.mjs",
    "validate:post-audit": "node scripts/validate-post-audit.mjs",
    "validate:seo-hardening": "node scripts/validate-seo-hardening.mjs",
    "validate:market-hubs": "node scripts/validate-market-hubs.mjs",
    "validate:priority-model-growth": "node scripts/validate-priority-model-growth.mjs",
    "validate:expressway-hub": "node scripts/validate-expressway-hub.mjs",
    "validate:budget-displacement": "node scripts/validate-budget-displacement-gaps.mjs",
    "lint": "eslint .",
    "validate:design": "node scripts/design-lint.mjs",
    "visual:matrix": "node scripts/visual-regression-matrix.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "@prisma/client": "6.5.0",
    "@opennextjs/cloudflare": "1.20.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.13.10",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "postcss": "8.5.26",
    "prisma": "6.5.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.8.2",
    "wrangler": "4.129.1",
    "@eslint/eslintrc": "3.3.7",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.24"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22 <25"
  }
}
